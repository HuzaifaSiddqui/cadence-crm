# ───── Server ─────
PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/cadence
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# Fill an EMPTY database with the demo workspace on boot (handy for first deploy)
AUTO_SEED=false

# ───── AI (optional) ─────
# Without a key, deal intelligence runs on the built-in explainable rules engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ───── Stripe (optional) ─────
# Without a key, billing runs in demo mode (simulated checkout).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
